{
  "manifest_version": 3,
  "name": "Listening Coach · Netflix Companion",
  "version": "0.2.2",
  "permissions": ["scripting"],
  "description": "Controls Netflix playback and section repeat from your local Listening Coach. It never reads or stores sign-in details.",
  "background": { "service_worker": "background.js", "type": "module" },
  "host_permissions": ["https://www.netflix.com/*"],
  "content_scripts": [
    { "matches": ["https://www.netflix.com/*"], "js": ["netflix.js"], "run_at": "document_idle" },
    { "matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["local-bridge.js"], "run_at": "document_idle" }
  ]
}
